# Copiar para .env e preencher. O .env nunca entra no repositório.
# Os valores reais ficam no gestor de passwords.

# Chave da API da Anthropic (console.anthropic.com > API Keys).
# Definir um limite mensal de gastos baixo na consola.
ANTHROPIC_API_KEY=

# URL do projeto Supabase (região UE): https://<ref>.supabase.co
# Painel > Project Settings > API.
SUPABASE_URL=

# Chave secreta (sb_secret_...): só no backend; ignora o RLS.
# Substitui a antiga service_role (ver docs/DECISOES.md, D-008).
SUPABASE_SECRET_KEY=

# Chave publicável (sb_publishable_...): pode ir para o frontend; só serve para o login.
# Substitui a antiga anon.
SUPABASE_PUBLISHABLE_KEY=

# Pasta com os YAML de configuração.
# Demo: config   |   Empresa real (fase 2, só local): config/empresa_real
CONFIG_DIR=

# desenvolvimento | producao
AMBIENTE=
